{
  "compilerOptions": {
    "allowJs" : true,
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmitOnError": true,
    "noImplicitAny": false,
    "outDir": "./dist",
    "inlineSourceMap": true,
    "jsx" : "react",
    "target": "es5",
    "removeComments": false,
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "node_modules/electron/*"
  ],
  "compileOnSave": false,
  "files": [
    "./src/main.tsx",
    "./src/index.tsx",
    "./src/components/RunButton.tsx",
    "./src/components/AppComponent.tsx"
  ]
}

