{
  "compilerOptions": {
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmitOnError": true,
    "noImplicitAny": false,
    "outDir": "./dist",
    "sourceMap": true,
    "jsx" : "react",
    "target": "es6",
    "removeComments": false
  },
  "exclude": [
    "node_modules",
    "dist"
  ],
  "compileOnSave": false
}
