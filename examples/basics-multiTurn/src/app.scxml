<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="initial-default" version="1.0" datamodel="ecmascript">
  <datamodel>
    <!-- via param --> 
    <data id="messageBuffer"/>

    <data id="companyData" src="file:../companyData.json"/>
    <data id="templateStrings" src="file:../locale/en/index.json"/>

    <data id="lastMessage"/>
    <data id="firstMessage"/>
  </datamodel>
  <script src="./send-common.js"></script>
  <state id="initial-default">
    <transition target="prompt" event="message"/>
  </state>
  <state id="prompt">
    <onentry>
      <assign location="firstMessage" expr="_event"/>
      <assign location="lastMessage" expr="_event"/>
      <script>
        send.call(this, lastMessage.data.message, templateStrings.helpMessage);
      </script>
    </onentry>
  </state>
  <!-- validate --> 
  <!-- if invalid, then prompt --> 
  <!-- otherwise, give the response, and we're done --> 
  <final id="end-conversation">
    <onentry>
      <script>
        send.call(this, lastMessage.data.message, "Goodbye until next time...");
      </script>
    </onentry>
  </final>
</scxml>

