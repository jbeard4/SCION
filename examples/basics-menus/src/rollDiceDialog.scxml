<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" initial="initial-default" version="1.0" datamodel="ecmascript">
  <datamodel>
    <!-- these passed in as params --> 
    <data id="messageBuffer"/>
    <data id="initialEvent"/>

    <data id="lastMessage"/>
  </datamodel>
  <script src="./send-common.js"></script>
  <state id="initial-default">
    <transition event="message">
      <assign location="lastMessage" expr="_event"/>
    </transition>
    <invoke type="http://www.w3.org/TR/scxml/" src="file:choice-dialog.scxml" autoforward="true">
      <param name="messageBuffer" expr="messageBuffer"/>
      <param name="prompt" expr="'How many dice should I roll?'"/>
      <param name="initialEvent" expr="initialEvent"/>
      <param name="type" expr="'number'"/>
    </invoke>
    <transition target="done" event="done.invoke"/>
  </state>
  <final id="done">
    <onentry>
      <script>
        if (_event.data > 0) {
            var msg = "I rolled:";
            for (var i = 0; i &lt; _event.data; i++) {
                var roll = Math.floor(Math.random() * 6) + 1;
                msg += ' ' + roll.toString(); 
            }
            send.call(this, lastMessage.data, msg);
        } else {
            send.call(this, lastMessage.data, "Ummm... Ok... I rolled air.");
        }
      </script>
    </onentry>
  </final>
</scxml>



