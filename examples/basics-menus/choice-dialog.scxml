<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" initial="initial-default" version="1.0" datamodel="ecmascript">
  <datamodel>
    <!-- these passed in as params --> 
    <data id="messageBuffer"/>
    <data id="prompt"/>
    <data id="choices"/>
    <data id="initialEvent"/>

    <data id="last_message_event"/>
    <data id="max_retries" expr="3"/>
    <data id="cur_retries" expr="0"/>
  </datamodel>
  <script>
    function send(){
      var args = Array.from(arguments);
      var event = args[0];
      var textArgs = args.slice(1);
      var message = {
        "type": event.type,
        "agent": "botbuilder",
        "source": event.source,
        "textLocale": event.textLocale,
        "address": event.address,
        "text": textArgs.join('')
      };
      messageBuffer.push(message);
    }
  </script>
  <script>
    function formatPrompt(prompt, choices){
      return prompt + '\n\n' + choices.map( function(choice, i){ return '  ' + (i+1) + '. ' + choice;}).join('\n');
    }
  </script>
  <state>
    <transition event="error">
      <log label="error" expr="[_sessionid,_event]"/>
    </transition>
    <state id="initial-default">
      <onentry>
        <script>
          send.call(this, initialEvent.data, formatPrompt(prompt, choices));
        </script>
      </onentry>
      <transition target="message-received" event="message"/>
    </state>
    <state id="message-received">
      <!-- validate message --> 
      <!-- for choice - match him against the choice. either substring of choice, or number option -->  
      <onentry>
        <assign location="last_message_event" expr="_event"/>
        <script>
          let text = _event.data.text;
          let numberRegex = /\b\d+\b/;
          let textRegex = new RegExp('\\b' + text + '\\b');
          let numberMatch = text.match(numberRegex);
          let choice;
          if(numberMatch){
            let idx = parseInt(numberMatch[0]) - 1;
            if(idx &lt; choices.length){
              choice = idx; 
            } 
          } else {
            let textMatches = choices.filter(function(choice){
              return choice.match(textRegex);
            });
            if (textMatches.length) {
              let firstTextMatch = textMatches[0];
              choice = choices.indexOf(firstTextMatch);
            }
          }
          if(typeof choice !== 'undefined'){
            this.raise({name : 'valid', data : choice});
          }else{
            this.raise({name : 'not.valid'});
          }
        </script>
      </onentry>
      <transition event="valid"  target="valid-done" />
      <transition event="not.valid" target="invalid-try-again" cond="cur_retries &lt; max_retries"/>
      <transition event="not.valid" target="invalid-done"/>
    </state>
    <state id="invalid-try-again">
      <onentry>
        <assign location="cur_retries" expr="cur_retries+1"/>
        <script>
          send.call(this, last_message_event.data, "I didn't understand. Please choose an option from the list");
        </script>
      </onentry>
      <transition target="message-received" event="message"/>
    </state>
  </state>
  <final id="valid-done">
    <donedata>
      <!-- return what he chose -->   
      <content expr="_event.data"/>
    </donedata>
  </final>
  <final id="invalid-done">
    <donedata>
      <content expr="false"/>
    </donedata>
  </final>
</scxml>
