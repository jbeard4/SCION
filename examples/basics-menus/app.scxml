<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:conf="http://www.w3.org/2005/scxml-conformance" initial="initial-default" version="1.0" datamodel="ecmascript">
  <datamodel>
    <!-- via param --> 
    <data id="messageBuffer"/>

    <data id="lastEvent"/>
  </datamodel>
  <script>
    function send(){
      var args = Array.from(arguments);
      var event = args[0];
      var textArgs = args.slice(1);
      var message = {
        "type": event.type,
        "agent": "botbuilder",
        "source": event.source,
        "textLocale": event.textLocale,
        "address": event.address,
        "text": textArgs.join('')
      };
      messageBuffer.push(message);
    }
  </script>
  <state id="initial-default">
    <transition target="prompt" event="message"/>
  </state>
  <state id="prompt">
    <onentry>
      <assign location="lastEvent" expr="_event"/>
    </onentry>
    <datamodel>
      <data id="choices" expr="['Flip A Coin','Roll Dice','Magic 8-Ball','Quit']"/>
    </datamodel>
    <transition event="error">
      <log label="error" expr="[_sessionid,_event]"/>
    </transition>
    <invoke type="http://www.w3.org/TR/scxml/" src="file:choice-dialog.scxml" autoforward="true">
      <param name="messageBuffer" expr="messageBuffer"/>
      <param name="prompt" expr="'Choose an option:'"/>
      <param name="choices" expr="choices"/>
      <param name="initialEvent" expr="_event"/>
    </invoke>
    <transition target="done" event="done.invoke.prompt"/>
  </state>
  <state id="done">
    <onentry>
      <script>
        send.call(this, lastEvent.data, choices[_event.data]);
      </script>
    </onentry>
  </state>
</scxml>

