{
  "name": "scion",
  "version": "5.0.4",
  "description": "SCION provides a system for developing with SCXML/Statecharts in JavaScript",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "bootstrap": "lerna bootstrap",
    "build": "npm run bootstrap && lerna run --sort build && npm run copy-dist",
    "copy-dist": "mkdir -p dist && cp projects/libraries/scxml/dist/scxml*.js dist/ && cp projects/devtools/debug/dist/scxml.debug.js dist/ && cp projects/libraries/core/dist/core.* dist/ && cp projects/libraries/schviz/dist/schviz.* dist/"
  },
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "lerna": "^3.22.1",
    "playwright": "^1.61.0"
  },
  "dependencies": {
    "react": "^15.6.1",
    "react-dom": "^15.6.1"
  },
  "filename": "scxml.min.js",
  "npmName": "scion",
  "npmFileMap": [
    {
      "basePath": "dist",
      "files": [
        "core.js",
        "core.js.map",
        "core.min.js",
        "schviz.js",
        "schviz.js.map",
        "schviz.min.js",
        "schviz.min.js.map",
        "scxml.debug.js",
        "scxml.js",
        "scxml.min.js"
      ]
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbeard4/scion.git"
  },
  "homepage": "https://github.com/jbeard4/scion#readme",
  "files": [
    "README.md",
    "dist/core.js",
    "dist/core.js.map",
    "dist/core.min.js",
    "dist/schviz.js",
    "dist/schviz.js.map",
    "dist/schviz.min.js",
    "dist/schviz.min.js.map",
    "dist/scxml.debug.js",
    "dist/scxml.js",
    "dist/scxml.min.js"
  ],
  "collective": {
    "type": "opencollective",
    "url": "https://opencollective.com/SCION"
  },
  "bugs": {
    "url": "https://github.com/jbeard4/scion/issues"
  }
}
