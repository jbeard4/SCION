{
  "name": "schviz",
  "version": "2.2.1",
  "description": "SCJSON to KGraph to SVG rendering library",
  "main": "dist/index.js",
  "dependencies": {
    "debug": "^2.6.3",
    "jquery": "^3.1.1",
    "jsondiffpatch": "^0.2.4",
    "klayjs": "^0.4.1",
    "pathseg": "^1.0.2",
    "q": "^1.4.1",
    "react": "^15.4.2",
    "scxml": "3.0.4",
    "snapsvg": "^0.4.0",
    "underscore": "^1.8.3"
  },
  "devDependencies": {
    "angular": "^1.5.8",
    "angular-route": "^1.5.8",
    "angularjs": "0.0.1",
    "bootstrap": "^3.3.7",
    "electron": "^1.6.2",
    "express": "^4.14.0",
    "grunt": "^1.0.1",
    "grunt-browserify": "^5.0.0",
    "grunt-contrib-watch": "^1.0.0",
    "grunt-express-server": "^0.5.3",
    "grunt-open": "^0.2.3",
    "load-grunt-tasks": "^3.5.2",
    "pathseg": "^1.0.2",
    "scxml-test-framework": "^1.0.2",
    "tsify": "^2.0.5",
    "typescript": "^2.1.4"
  },
  "scripts": {
    "test": "karma",
    "build": "tsc -p .  --sourceMap",
    "watch": "tsc -p .  --sourceMap -w",
    "browserify": "browserify -p tsify --project . src/index.ts  --standalone SCHVIZ --debug -o dist/schviz.js",
    "browserify-watch": "watchify -p tsify --project . src/index.ts --standalone SCHVIZ --debug -o dist/schviz.js  --verbose",
    "minfiy": "uglify -s dist/schviz.js -o dist/schviz.min.js",
    "clean": "rm -rf dist/"
  },
  "repository": {
