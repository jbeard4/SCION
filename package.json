{
  "name": "@scion-scxml/dashboard",
  "author": "Jacob Beard <jake@jacobeanrnd.com>",
  "version": "1.0.5",
  "description": "",
  "main": "./dist/containers/App",
  "scripts": {
    "start": "electron .",
    "watch": "tsc -p . --outDir dist/ -w & ( cd dist; watchify --exclude electron index.js -d  -o 'cat > scion-scxml-dashboard.js; sorcery -i scion-scxml-dashboard.js' -v )",
    "preversion": "npm run build",
    "postversion": "git push --follow-tags && npm publish",
    "build": "npm run transpile && npm run bundle && npm run minify",
    "transpile": "tsc -p . --outDir dist/",
    "bundle": "cd dist; browserify -t browserify-css --exclude electron index.js -d  -o scion-scxml-dashboard.js -v; sorcery -i scion-scxml-dashboard.js",
    "minify": "cd dist; uglifyjs scion-scxml-dashboard.js --in-source-map scion-scxml-dashboard.js.map  --source-map  -o scion-scxml-dashboard.min.js",
    "clean": "rm -rf dist/*",
    "server": "node grunt/server.js",
    "harness": "opn http://localhost:3001/test-integration/index.html"
  },
  "dependencies": {
    "@scion-scxml/jsondiffpatch": "^0.2.10",
    "@scion-scxml/react-collapsible": "^2.0.11",
    "@scion-scxml/schviz": "^3.2.9",
    "@scion-scxml/scxml": "^4.3.7",
    "@types/jquery": "^1.10.33",
    "@types/slickgrid": "^2.1.25",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "babel-plugin-transform-es3-member-expression-literals": "^6.22.0",
    "babel-polyfill": "^6.26.0",
    "classnames": "^2.1.2",
    "font-awesome": "^4.7.0",
    "jquery": "1.11.2",
    "jquery-ui": "^1.12.1",
    "jquery-ui-dist": "^1.12.1",
    "jquery-ui-themes": "^1.12.0",
    "react-inspector": "^2.2.2",
    "react-redux": "^5.0.6",
    "react-ui-layout": "^1.0.4",
    "redux": "^3.1.5",
    "slickgrid": "^2.3.15",
    "ui-contextmenu": "^1.18.1",
    "underscore": "^1.8.3"
  },
  "browserify": {
    "transform": [
      [
        "babelify",
        {
          "presets": [
            "es2015"
          ],
          "plugins": [
            "transform-class-properties"
          ]
        }
      ],
      "browserify-css"
    ]
  },
  "devDependencies": {
    "@types/es6-shim": "0.31.33",
    "@types/react": "15.6.1",
    "@types/react-dom": "0.14.23",
    "@types/react-redux": "^4.4.40",
    "@types/redux": "^3.6.0",
    "babel": "^6.23.0",
    "babel-cli": "^6.26.0",
    "babel-core": "^6.3.15",
    "babel-loader": "^6.2.0",
    "babel-plugin-add-module-exports": "^0.1.1",
    "babel-plugin-react-transform": "^2.0.0-beta1",
    "babel-plugin-transform-decorators-legacy": "^1.2.0",
    "babel-polyfill": "^6.3.14",
    "babel-preset-es2015": "^6.24.1",
    "babel-preset-es2015-loose": "^8.0.0",
    "babel-preset-react": "^6.3.13",
    "babel-preset-stage-0": "^6.3.13",
    "babelify": "^7.3.0",
    "bootstrap": "^3.3.7",
    "browserify": "^14.5.0",
    "browserify-css": "^0.10.0",
    "electron-devtools-installer": "^2.2.1",
    "exorcist": "^0.4.0",
    "expect": "^1.8.0",
    "express": "^4.14.0",
    "jsdom": "^5.6.1",
    "mocha": "^2.2.5",
    "node-libs-browser": "^0.5.2",
    "opn-cli": "^3.1.0",
    "pathseg": "^1.0.2",
    "raw-loader": "^0.5.1",
    "react-addons-test-utils": "^0.14.0",
    "react-transform-hmr": "^1.0.0",
    "sorcery": "^0.10.0",
    "style-loader": "^0.12.3",
    "todomvc-app-css": "^2.0.1",
    "tsify": "^2.0.8",
    "typescript": "2.3.3",
    "uglify-js": "^2.8.21",
    "uglifyify": "^3.0.4",
    "watchify": "^3.9.0"
  },
  "gitHead": "0838a38c74a63ce40c48168e03c4e783e37c1731"
}
