{
  "name": "scxml-tool",
  "version": "1.0.3",
  "description": "A minimal standalone graphical SCXML simulation environment.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "watch": "tsc --jsx react --allowJs --outDir dist/ --module commonjs src/index.tsx -w",
    "build": "npm run transpile & npm run bundle && npm run minify",
    "transpile": "tsc -p . --outDir dist/",
    "bundle": "browserify -p tsify --project . --exclude optimist --exclude electron --bare src/index.tsx -r ./node_modules/babel-polyfill --debug | exorcist dist/index.js.map > dist/index.js",
    "minify": " uglifyjs -o dist/index.min.js dist/index.js",
    "package": "electron-packager .",
    "clean": "rm -rf dist/*",
    "postinstall": "typings install"
  },
  "dependencies": {
    "optimist": "^0.6.1",
    "react": "^15.4.2",
    "react-dom": "^15.4.2",
    "scxml": "3.0.4",
    "schviz2": "2.2.1",
    "font-awesome": "^4.7.0"
  },
  "keywords": [
    "SCXML"
  ],
  "author": "Jacob Beard <jake@jacobeanrnd.com>",
  "license": "CC-BY-NC-SA-4.0",
  "devDependencies": {
    "@types/jquery": "^2.0.41",
    "@types/node": "^7.0.12",
    "@types/react": "^15.0.21",
    "@types/react-dom": "^0.14.23",
    "babel-polyfill": "^6.23.0",
    "browserify": "^14.3.0",
    "electron": "^1.4.1",
    "electron-packager": "^8.6.0",
    "scxml-test-framework": "^1.0.2",
    "typescript": "^2.1.4",
    "typings": "^2.1.0"
  }
}
