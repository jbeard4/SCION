{
  "name": "schviz",
  "version": "2.2.1",
  "description": "SCJSON to KGraph to SVG rendering library",
  "main": "dist/index.js",
  "dependencies": {
    "debug": "^2.6.3",
    "jquery": "^3.1.1",
    "jsondiffpatch": "^0.2.4",
    "klayjs": "^0.4.1",
    "pathseg": "^1.0.2",
    "q": "^1.4.1",
    "react": "^15.4.2",
    "scxml": "3.0.4",
    "snapsvg": "^0.4.0",
    "underscore": "^1.8.3"
  },
  "devDependencies": {
    "angular": "^1.5.8",
    "angular-route": "^1.5.8",
    "angularjs": "0.0.1",
    "babel": "^6.23.0",
    "bootstrap": "^3.3.7",
    "browserify": "^14.3.0",
    "electron": "^1.6.2",
    "exorcist": "^0.4.0",
    "express": "^4.14.0",
    "grunt": "^1.0.1",
    "grunt-browserify": "^5.0.0",
    "grunt-contrib-watch": "^1.0.0",
    "grunt-express-server": "^0.5.3",
    "grunt-open": "^0.2.3",
    "load-grunt-tasks": "^3.5.2",
    "pathseg": "^1.0.2",
    "scxml-test-framework": "^1.0.2",
    "tsify": "^2.0.5",
    "typescript": "^2.1.4",
    "uglify-js": "^2.8.21"
  },
  "scripts": {
    "test": "karma",
    "build": "npm run compile && npm run transpile && npm run bundle && npm run minify",
    "compile": "tsc -p .  --sourceMap --outDir dist/es6",
    "transpile": "babel -s --presets es2015 --out-dir dist/es5/ dist/es6/",
    "bundle": "mkdir -p dist/bundle && browserify --exclude optimist --exclude electron -d --standalone SCHVIZ  dist/es5/index.js | exorcist dist/bundle/index.js.map > dist/bundle/index.js",
    "minify": "mkdir -p dist/minified && uglifyjs --source-map dist/minified/index.min.js.map -o dist/minified/index.min.js dist/bundle/index.js",
    "clean": "rm -rf dist/*"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/JacobeanRnD/SCHVIZ2.git"
  },
  "keywords": [
    "scxml"
  ],
  "author": "Jacob Beard <jake@jacobeanrnd.com>",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/jbeard4/SCHVIZ2/issues"
  },
  "homepage": "https://github.com/jbeard4/SCHVIZ2#readme"
}
