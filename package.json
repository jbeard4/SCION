{
  "name": "@scion-scxml/schviz",
  "version": "3.2.19",
  "description": "SCXML visualization library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "@scion-scxml/core-base": "^1.0.17",
    "@scion-scxml/scxml": "^4.3.19",
    "babel-polyfill": "^6.23.0",
    "babel-preset-es2015": "^6.24.1",
    "classnames": "^2.2.5",
    "debug": "^2.6.3",
    "grunt": "^1.0.1",
    "jquery": "^3.1.1",
    "jquery-ui-dist": "^1.12.1",
    "klayjs": "^0.4.1",
    "licensezero-postinstall": "^1.0.0",
    "load-awesome": "^1.1.0",
    "pathseg": "^1.0.2",
    "q": "^1.4.1",
    "ui-contextmenu": "^1.18.1",
    "underscore": "^1.8.3"
  },
  "peerDependencies": {
    "jquery": "^3.1.1",
    "jquery-ui-dist": "^1.12.1",
    "ui-contextmenu": "^1.18.1"
  },
  "devDependencies": {
    "@types/es6-shim": "0.31.33",
    "@types/jquery": "2.0.41",
    "@types/node": "7.0.12",
    "@types/react": "15.6.1",
    "@types/react-dom": "0.14.23",
    "angular": "^1.5.8",
    "angular-route": "^1.5.8",
    "angularjs": "0.0.1",
    "babel": "^6.23.0",
    "babelify": "^7.3.0",
    "bootstrap": "^3.3.7",
    "browserify": "^14.3.0",
    "browserify-css": "^0.10.0",
    "electron": "^1.6.2",
    "exorcist": "^0.4.0",
    "express": "^4.14.0",
    "opn-cli": "^3.1.0",
    "pathseg": "^1.0.2",
    "sorcery": "^0.10.0",
    "tsify": "^2.0.8",
    "typescript": "2.3.3",
    "uglify-js": "^2.8.21",
    "uglifyify": "^3.0.4",
    "watchify": "^3.9.0"
  },
  "scripts": {
    "watch": "tsc -p . --outDir dist/ -w & ( cd dist; watchify --exclude electron index.js -d  -s schviz -o 'cat > schviz.js; sorcery -i schviz.js' -v )",
    "preversion": "npm run build",
    "postversion": "git push --follow-tags && npm publish",
    "build": "mkdir -p dist && npm run transpile && npm run bundle && npm run fix-global && npm run minify",
    "transpile": "tsc -p . --outDir dist/",
    "fix-global": "sed -i -e 's/g.schviz = f()/g.scion = g.scion || {}; g.scion.schviz = f().default;/' dist/schviz.js",
    "bundle": "cd dist; browserify --exclude electron --exclude @scion-scxml/scxml index.js -d  -s schviz -o schviz.js -v; sorcery -i schviz.js",
    "minify": "cd dist; uglifyjs schviz.js --in-source-map schviz.js.map  --source-map schviz.min.js.map  -o schviz.min.js",
    "clean": "rm -rf dist/*",
    "server": "node grunt/server.js",
    "start": "npm run server",
    "harness": "opn http://localhost:3001/test-integration/index.html",
    "postinstall": "licensezero-postinstall"
  },
  "browserify": {
    "transform": [
      [
        "browserify-css"
      ]
    ]
  },
  "repository": {
    "type": "git",
    "url": "git://gitlab.com/scion-scxml/schviz.git"
  },
  "keywords": [
    "scxml"
  ],
  "author": "Jacob Beard <jake@jacobeanrnd.com>",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://gitlab.com/scion-scxml/schviz/issues"
  },
  "homepage": "https://gitlab.com/scion-scxml/schviz#readme",
  "gitHead": "0838a38c74a63ce40c48168e03c4e783e37c1731"
}
