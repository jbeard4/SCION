{
  "name": "schviz-test-framework",
  "version": "2.2.2",
  "description": "SCJSON to KGraph to SVG rendering library",
  "main": "dist/index.js",
  "devDependencies": {
    "scion-core-base": "^1.0.0",
    "scxml": "^4.3.1",
    "@jbeard/console-component": "1.0.3",
    "@types/jquery": "^2.0.41",
    "@types/react": "15.6.1",
    "@types/react-dom": "0.14.23",
    "babel-polyfill": "^6.23.0",
    "debug": "^2.6.3",
    "jquery": "^3.1.1",
    "jquery-ui-dist": "^1.12.1",
    "ui-contextmenu": "^1.18.1",
    "babel": "^6.23.0",
    "babelify": "^7.3.0",
    "bootstrap": "^3.3.7",
    "browserify": "^14.3.0",
    "browserify-css": "^0.10.0",
    "exorcist": "^0.4.0",
    "express": "^4.14.0",
    "opn-cli": "^3.1.0",
    "sorcery": "^0.10.0",
    "typescript": "^2.2.2",
    "uglify-js": "^2.8.21",
    "watchify": "^3.9.0"
  },
  "scripts": {
    "watch": "tsc -p . --outDir dist/ -w & ( cd dist; watchify index.js -d  -o 'cat > main.js; sorcery -i main.js' -v )",
    "preversion": "npm run build",
    "postversion": "git push --follow-tags origin master && npm publish",
    "build": "npm run transpile && npm run bundle",
    "transpile": "tsc -p . --outDir dist/",
    "bundle": "cd dist; browserify index.js -d  -o main.js -v; sorcery -i main.js",
    "clean": "rm -rf dist/*",
    "server": "node grunt/server.js",
    "harness": "opn http://localhost:3001/test-integration/index.html"
  },
  "browserify": {
    "transform": [
      [
        "browserify-css"
      ]
    ]
  },
  "keywords": [
    "scxml"
  ],
  "author": "Jacob Beard <jake@jacobeanrnd.com>",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/jbeard4/SCHVIZ2/issues"
  },
  "homepage": "https://github.com/jbeard4/SCHVIZ2#readme",
  "dependencies": {
    "scxml-test-framework": "^2.0.0",
    "whatwg-fetch": "^2.0.3"
  }
}
